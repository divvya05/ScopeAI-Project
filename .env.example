# ============================================================
# ScopeAI environment variables — copy to .env (or rely on the
# .env.local file that `neon link` generates in this directory).
# ============================================================

# Neon Postgres connection string (server-side only — never in the client).
# Provided automatically by: neon link --project-id <id> --branch production
DATABASE_URL=

# ---- Optional: AI-powered recommendations --------------------------
# Free / open models served from an OpenAI-compatible endpoint.
# Defaults point at a local Ollama install. Set AI_ENABLED=true to use it.
AI_ENABLED=false
AI_API_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL_GENERAL=llama3.1
AI_MODEL_FAST=gemma2
AI_TIMEOUT_MS=15000

# API server port
PORT=8787